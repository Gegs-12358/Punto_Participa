# Plantilla de variables de entorno de Punto Participa.
# Copia este archivo como ".env" y reemplaza los valores de ejemplo.
# Reglas: sin comillas, sin espacios (ni al final de la linea) y sin el signo "$".
# Nunca subas el archivo ".env" real a GitHub ni pegues sus claves en un chat.

# --- Django ---
SECRET_KEY=cambiar_por_64_caracteres_alfanumericos_aleatorios

# --- Base de datos ---
DB_NAME=punto_participa_db
DB_USER=punto_user
DB_PASSWORD=cambiar_por_una_clave_larga_y_aleatoria
# Dentro de Docker, docker-compose.yml fija DB_HOST=db y DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5432

# --- Correo (Gmail, con clave de aplicacion) ---
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=cambiar_por_la_clave_de_aplicacion
SITE_URL=http://127.0.0.1:8000
MAX_INVITACIONES_POR_ENVIO=15
# Por defecto los correos se imprimen en la consola (docker compose logs web).
# Para enviarlos de verdad, descomenta estas dos lineas:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=Punto Participa <tu_correo@gmail.com>

# --- Modo de ejecucion ---
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Respaldo automatico (historia 008, ver respaldo/LEEME.md) ---
# Carpeta del computador donde se guardan los respaldos. Debe existir y ser tuya.
# Para tener la copia fuera del equipo, apunta a un disco externo o a una carpeta
# sincronizada (Google Drive, OneDrive). Ej.: /media/usuario/DISCO/respaldos_pp
RESPALDO_DIR=./respaldos
# Cada cuantas horas se respalda y cuantos dias se guardan los respaldos diarios.
# El primero de cada mes se guarda en mensuales/ y no se borra nunca.
RESPALDO_CADA_HORAS=24
RESPALDO_DIAS=30
# Tu usuario del computador (en Linux: comando "id -u" y "id -g"). Normalmente 1000.
RESPALDO_UID=1000
RESPALDO_GID=1000

# --- Solo para produccion, con dominio y HTTPS (descomentar al desplegar) ---
# CSRF_TRUSTED_ORIGINS=https://tu-dominio.cl
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# Si Nginx (u otro proxy) recibe el HTTPS y le pasa la peticion a Django:
# USAR_PROXY_HTTPS=True
