# Plantilla de variables de entorno de Punto Participa.
# Copia este archivo como ".env" y reemplaza los valores de ejemplo.
# Reglas: sin comillas, sin espacios (ni al final de la linea) y sin el signo "$".
# Nunca subas el archivo ".env" real a GitHub ni pegues sus claves en un chat.

# --- Django ---
SECRET_KEY=cambiar_por_64_caracteres_alfanumericos_aleatorios

# --- Base de datos ---
DB_NAME=punto_participa_db
DB_USER=punto_user
DB_PASSWORD=cambiar_por_una_clave_larga_y_aleatoria
# Dentro de Docker, docker-compose.yml fija DB_HOST=db y DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5432

# --- Correo (Gmail, con clave de aplicacion) ---
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=cambiar_por_la_clave_de_aplicacion
SITE_URL=http://127.0.0.1:8000
MAX_INVITACIONES_POR_ENVIO=15

# --- Modo de ejecucion ---
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Solo para produccion (descomentar al desplegar) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
